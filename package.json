{
  "name": "kicad-lens-monorepo",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/webview",
    "packages/extension"
  ],
  "scripts": {
    "build": "npm run build -w packages/webview && npm run build -w packages/extension",
    "watch": "npm run watch -w packages/extension",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "package": "npm run build && npm run package -w packages/extension"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
